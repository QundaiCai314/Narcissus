# Copy to .env. These credentials are ONLY for isolated local development.
ENVIRONMENT=development
APP_SECRET=development-only-change-this-secret-32
PUBLIC_ORIGIN=http://localhost:3000
WEB_BIND=127.0.0.1
WEB_PORT=3000
POSTGRES_USER=narcissus
POSTGRES_DB=narcissus
POSTGRES_PASSWORD=narcissus_dev_password
MINIO_ROOT_USER=narcissus_dev
MINIO_ROOT_PASSWORD=narcissus_dev_password
# Optional: override with a trusted, available MinIO container image.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-06-13T11-33-47Z
S3_BUCKET=narcissus-private
S3_REGION=us-east-1

# Required for actual model calls; never prefix keys with NEXT_PUBLIC_.
# Independently configurable OpenAI-compatible chat and embeddings endpoints.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.stepfun.com/v1
CHAT_MODEL=step-3.5-flash
CHAT_TEMPERATURE=0.1
# Reasoning-capable models may share this budget between thinking and the visible answer.
CHAT_MAX_TOKENS=8192
# Provider compatibility; legacy endpoints keep these defaults.
CHAT_MAX_TOKENS_PARAMETER=max_tokens
CHAT_SEND_TEMPERATURE=true
CHAT_REASONING_EFFORT=
# For gpt-5.6-luna: max_completion_tokens, false, medium respectively.
# Set CHAT_BASE_URL and CHAT_API_KEY for your authorized provider separately.
CHAT_SEND_USAGE=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_BATCH_SIZE=10
# The workspace-specific Beijing endpoint from the Bailian console can replace EMBEDDING_BASE_URL.
WRITING_MAX_CONTEXT_CHARS=24000
WRITING_MAX_TOKENS=4096
LEARNING_MAX_TOKENS=16384
MODEL_TIMEOUT_SECONDS=60
GENERATION_TIMEOUT_SECONDS=180
RETRIEVAL_MAX_DISTANCE=0.55

# Production: change all passwords, use ENVIRONMENT=production, HTTPS PUBLIC_ORIGIN.
# Compose uses private MinIO by default. To use another S3 service, override below.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=narcissus_dev
S3_SECRET_KEY=narcissus_dev_password
# Replace with a random password of at least 16 characters in production.
REDIS_PASSWORD=narcissus_dev_redis

# PDF size limit; frontend currently matches 200 MiB. MAX_PDF_PAGES remains 100.
MAX_UPLOAD_MB=200
# Local Chinese/English image recognition; no cloud OCR key or external OCR calls.
OCR_ENABLED=true
OCR_MAX_PAGES=30
OCR_PAGE_TIMEOUT_SECONDS=30
OCR_TOTAL_TIMEOUT_SECONDS=160

# V4: independent StepFun binary speech API. Optional until audio synthesis is used.
# May use an authorized StepFun key; there is deliberately no implicit chat-key fallback.
TTS_API_KEY=
TTS_BASE_URL=https://api.stepfun.com/v1
TTS_MODEL=step-tts-mini
TTS_DEFAULT_VOICE=cixingnansheng
TTS_SECOND_VOICE=wenrounvsheng
TTS_TIMEOUT_SECONDS=90
AUDIO_MAX_CHARS=4000
AUDIO_MAX_SEGMENTS=40
AUDIO_MAX_DURATION_SECONDS=1200
AUDIO_USER_CONCURRENCY=2
# Combined script/render admissions, including manual retries; UTC+8 calendar day.
AUDIO_DAILY_LIMIT=20

# V5 多来源导入；原有上传限制 MAX_UPLOAD_MB / MAX_PDF_PAGES 继续生效。
MAX_BATCH_FILES=10
MAX_UNPACKED_MB=60
MAX_IMAGE_PIXELS=25000000
IMPORT_USER_CONCURRENCY=2
OCR_DAILY_PAGES=200
WEB_MAX_BYTES=3000000
WEB_TIMEOUT_SECONDS=20
WEB_MAX_REDIRECTS=3
# 默认系统 DNS；代理使用 fake-IP 时可显式选择 cloudflare（固定 DoH，仅发送域名）。
# 两种模式均拒绝私网结果，不自动绕过拒绝；部署网络须可连接受信 DNS。
WEB_DNS_MODE=system
# V6：阶跃星辰独立搜索接口，与聊天模型配置分离。
# 可填写独立搜索密钥；仅官方同域 StepFun 配置允许显式复用已有聊天密钥。
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.stepfun.com/v1
SEARCH_REUSE_STEPFUN_KEY=false
SEARCH_TIMEOUT_SECONDS=40
RESEARCH_MAX_RESULTS=10
RESEARCH_MAX_FETCHES=8
RESEARCH_DAILY_SEARCHES=20
RESEARCH_USER_CONCURRENCY=2
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_MAX_TOKENS=16384

# V7：沿用 CHAT_* 与 EMBEDDING_*，无需新增模型供应商。
VISUAL_USER_CONCURRENCY=2
VISUAL_DAILY_JOBS=50
VISUAL_MAX_TOKENS=12000
# Optional provider features, verified with StepFun step-3.5-flash.
# For other compatible providers leave false / blank unless supported.
VISUAL_JSON_MODE=true
VISUAL_REASONING_EFFORT=low
VISUAL_RENDER_TIMEOUT=90
VISUAL_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
